{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "what-to-eat-in-shou-contributions",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "what-to-eat-in-shou-contributions",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "PENDING_IMAGES",
    "bucket_name": "what-to-eat-in-shou-contributions-pending"
  }],
  "vars": {
    "ALLOWED_ORIGINS": ""
  }
}
